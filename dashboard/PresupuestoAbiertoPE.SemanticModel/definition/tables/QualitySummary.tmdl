/// Evidencia de calidad del run (métricas del gold summary).
table QualitySummary
	lineageTag: 5c9e2b74-1a8d-4f36-b9e5-7d2c6a1f8b43

	/// Valor de la métrica de calidad seleccionada.
	measure 'Valor' = SUM('QualitySummary'[value])
		formatString: #,0.##
		displayFolder: Resumen
		lineageTag: 2b7d4e91-6c3a-4f58-9e1b-5a8c2d7f4e63

	column metric
		dataType: string
		isHidden
		lineageTag: 8a2d6f19-4c7b-4e58-9a3f-1b5e9c2d7f64
		summarizeBy: none
		sourceColumn: metric

	/// Nombre legible de la métrica de calidad.
	column 'Métrica' = SWITCH('QualitySummary'[metric], "entities", "Municipalidades", "avg_execution_pct", "Ejecución promedio (%)", "best_execution_pct", "Mejor ejecución (%)", "worst_execution_pct", "Peor ejecución (%)", "low_execution_alerts", "Alertas < 60%", 'QualitySummary'[metric])
		dataType: string
		lineageTag: 3e7b1a95-6d2c-4f48-8b1e-5a9f3c7d2e16
		summarizeBy: none

	column value
		dataType: double
		formatString: 0.0
		lineageTag: 9f4c7a23-1e8b-4d56-a2c9-6b3f8d1e5a47
		summarizeBy: none
		sourceColumn: value

	partition QualitySummary = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\gold_summary.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted,{{"metric", type text}, {"value", type number}})
				in
				    Typed
